# AI IDE Backend Configuration
# Copy this file to .env and fill in your actual values

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Provider Settings
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.6-flash
CODING_MODEL=gemini-3.6-flash
THINKING_MODEL=gemini-3.6-flash

# Available Gemini Models (comma-separated)
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-pro-latest

# CORS Origins (comma-separated)
# Development: http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
# Production: https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Workspace Directory
# Set to the directory you want the IDE to work with
# WORKSPACE_DIR=/path/to/your/workspace

# Optional: Groq Configuration (if implementing Groq support in future)
# GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1
